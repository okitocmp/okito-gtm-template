___TESTS___

scenarios:
- name: Okito CDN script is injected with the correct URL
  code: |-
    const mockData = {
      websiteKey: 'okito-abc123-def456-d',
      notRequiredMode: 'granted',
      usOptOut: false,
      waitForUpdate: 500,
      adsDataRedaction: true,
      urlPassthrough: true,
      developerId: 'dZGJiMm'
    };

    mock('queryPermission', function(permission, url) {
      return true;
    });
    mock('setDefaultConsentState', function(state) {});
    mock('gtagSet', function(settings) {});
    mock('injectScript', function(url, onSuccess, onFailure) {
      assertThat(url).isEqualTo('https://cdn.okito.com/js/okito-abc123-def456-d');
      onSuccess();
    });

    runCode(mockData);

    assertApi('injectScript').wasCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: Opt-in regions start denied, everywhere else granted
  code: |-
    const mockData = {
      websiteKey: 'okito-abc123-def456-d',
      notRequiredMode: 'granted',
      usOptOut: false,
      waitForUpdate: 500,
      adsDataRedaction: true,
      urlPassthrough: true,
      developerId: 'dZGJiMm'
    };

    const states = [];
    mock('setDefaultConsentState', function(state) { states.push(state); });
    mock('gtagSet', function(settings) {});
    mock('queryPermission', function(permission, url) { return true; });
    mock('injectScript', function(url, onSuccess, onFailure) { onSuccess(); });

    runCode(mockData);

    assertThat(states.length).isEqualTo(2);
    assertThat(states[0].ad_storage).isEqualTo('denied');
    assertThat(states[0].analytics_storage).isEqualTo('denied');
    assertThat(states[0].ad_user_data).isEqualTo('denied');
    assertThat(states[0].ad_personalization).isEqualTo('denied');
    assertThat(states[0].functionality_storage).isEqualTo('granted');
    assertThat(states[0].security_storage).isEqualTo('granted');
    assertThat(states[0].wait_for_update).isEqualTo(500);
    assertThat(states[0].region).contains('DE');
    assertThat(states[0].region).contains('GB');
    assertThat(states[0].region).contains('US');
    assertThat(states[1].region).isUndefined();
    assertThat(states[1].ad_storage).isEqualTo('granted');
    assertThat(states[1].analytics_storage).isEqualTo('granted');
    assertThat(states[1].wait_for_update).isEqualTo(0);
